{
  "name": "robovolunteers",
  "version": "1.0.0",
  "private": true,
  "description": "RoboVolunteers - VEX Robotics volunteer management and event coordination",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "dev:test": "wrangler dev --config wrangler.jsonc --env test",
    "dev:worker": "npm --prefix workers/auth-otp run dev",
    "dev:worker:test": "npm --prefix workers/auth-otp run dev:test",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 web",
    "build:test": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 -Target web -Env test",
    "build:worker": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 worker",
    "build:all": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 all",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:all": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -DeployWorker",
    "deploy:dry-run": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -DryRun",
    "deploy:test": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Env test",
    "deploy:test:all": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Env test -DeployWorker",
    "deploy:test:dry-run": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Env test -DryRun",
    "deploy:worker": "npm --prefix workers/auth-otp run deploy",
    "deploy:worker:test": "npm --prefix workers/auth-otp run deploy:test",
    "deploy:auth": "npx -y firebase-tools@latest deploy --only auth --project default",
    "deploy:auth:test": "npx -y firebase-tools@latest deploy --only auth --project test",
    "deploy:firestore": "npx -y firebase-tools@latest deploy --only firestore --project default",
    "deploy:firestore:test": "npx -y firebase-tools@latest deploy --only firestore --project test",
    "test:worker": "npm --prefix workers/auth-otp test",
    "typecheck:worker": "npm --prefix workers/auth-otp run typecheck",
    "typecheck": "npm --prefix workers/auth-otp run typecheck"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
