{
  // Cloudflare Workers Static Assets configuration for RoboVolunteers (Flutter Web SPA).
  // Static requests + SPA fallback are served directly from Cloudflare's edge with free unlimited bandwidth.
  "name": "roboref-volunteer-hub",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./app/build/web",
    "not_found_handling": "single-page-application"
  },
  // Custom domain route serving the Flutter Web SPA (while /api/* is handled by RoboAppsServer).
  "routes": [
    {
      "pattern": "robovolunteers.link",
      "custom_domain": true
    }
  ],
  "env": {
    "test": {
      "name": "robovolunteers-test",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "./app/build/web",
        "not_found_handling": "single-page-application"
      },
      "routes": [
        {
          "pattern": "test.robovolunteers.link",
          "custom_domain": true
        }
      ]
    }
  }
}
