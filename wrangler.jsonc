{
  // Cloudflare Workers Static Assets configuration for RoboVolunteers (Flutter Web SPA).
  // Static requests + SPA fallback are served directly from Cloudflare's edge with free unlimited bandwidth.
  "name": "roboref-volunteer-hub",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./app/build/web",
    "not_found_handling": "single-page-application"
  }
  // Uncomment once roboref.app is active in your Cloudflare account to attach volunteer.roboref.app:
  // ,"routes": [
  //   {
  //     "pattern": "volunteer.roboref.app",
  //     "custom_domain": true
  //   }
  // ]
}
