{
  // Cloudflare Worker configuration for RoboVolunteers 6-digit Email OTP + Invite Gate
  "name": "roboref-volunteer-auth-otp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_OTP_KV",
      "id": "56a7095032b24708883e172169b4ae27"
    }
  ],
  "vars": {
    "SENDER_EMAIL": "noreply@roboref.app",
    "SENDER_NAME": "RoboVolunteers",
    "MAX_DAILY_EMAILS_PER_USER": "12",
    "MAX_HOURLY_EMAILS_PER_IP": "20",
    "MAX_MINUTE_EMAILS_PER_IP": "5",
    "MAX_DAILY_EMAILS_GLOBAL": "150",
    "OTP_COOLDOWN_SECONDS": "60",
    "OTP_TTL_SECONDS": "600",
    "MAX_OTP_ATTEMPTS": "5",
    "REQUIRE_TURNSTILE": "false",
    "ALLOWED_ORIGINS": "https://robovolunteers.link,https://*.robovolunteers.link,https://volunteer.roboref.app,https://roboref.app,https://*.roboref.app,https://roboref-volunteer-hub.james-pearson.workers.dev,https://*.james-pearson.workers.dev,https://volunteer-wrangler.web.app,https://volunteer-wrangler.firebaseapp.com,http://localhost:5000,http://localhost:8080"
  }
}
